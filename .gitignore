# Aula · lo que NO se sube a GitHub (ver docs/PUBLISHING.md)

# ── Dependencias y compilación ──
node_modules/
out/
release/
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# ── Capturas y pruebas sueltas (se rehacen con scripts/shot.mjs y los revisores) ──
shots/
__judge__/

# ── Modelos y cachés descargados (cientos de MB; Aula los descarga sola) ──
.model-cache/
*.onnx
*.gguf

# ── Temporales ──
tmp/
temp/
*.tmp
*.log
*.orig
*.swp
*~

# ── Secretos (por si acaso: las claves van en el sistema o FUERA del proyecto) ──
.env
.env.*
secrets.json
secrets.enc
*.p12
*.pem
*private*key*

# ── macOS ──
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# ── Copias de trabajo temporales de los agentes ──
.claude/worktrees/

# ── Tailscale (proceso auxiliar): la herramienta de Go del proyecto y lo que compila ──
.toolchain/
native/tsnet/bin/
native/ios/Frameworks/
native/ios/_verify/.derived/
xcuserdata/
# la demostración de la app de iOS: se graba con scripts/dev/ios-demo.mjs antes de archivar
native/ios/Aula/Demo.aulademo
