{
  "name": "aula",
  "productName": "Aula",
  "version": "0.1.1",
  "description": "Aula — your study companion: turns your notes, slides and past exams, or any topic, into an interactive course and studies it with you.",
  "author": "Luum Labs",
  "license": "AGPL-3.0-only",
  "private": true,
  "homepage": "https://github.com/luumlabs/aula",
  "repository": {
    "type": "git",
    "url": "https://github.com/luumlabs/aula.git"
  },
  "bugs": "https://github.com/luumlabs/aula/issues",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test -c tests/e2e/playwright.config.ts",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "docx": "9.14.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.11",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "pdfjs-dist": "5.4.296",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "1.1.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.180.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-geo": "3.1.1",
    "date-fns": "4.4.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "highlight.js": "11.11.1",
    "i18next": "25.6.0",
    "katex": "0.18.10",
    "lucide-react": "0.545.0",
    "motion": "12.43.0",
    "playwright": "1.63.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-i18next": "16.2.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.3",
    "three": "0.180.0",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "world-atlas": "2.0.2",
    "zustand": "5.0.16"
  },
  "overrides": {
    "katex": "$katex"
  }
}
