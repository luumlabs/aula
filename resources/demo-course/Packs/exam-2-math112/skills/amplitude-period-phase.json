   "type": "recap",
   "points": [
    "Amplitude $|A|$, period $\\frac{2\\pi}{B}$, midline $y=D$.",
    "Factor $B$ before reading the phase shift.",
    "$x-C$ moves right; $x+C$ moves left."
   ]
  }
