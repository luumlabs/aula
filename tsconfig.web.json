{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "outDir": "out/tsc-web"
  },
  "include": ["src/renderer/src/**/*", "src/preload/*.d.ts", "src/shared/**/*", "src/engine/**/*"],
  "exclude": ["src/engine/**/*.node.ts", "src/engine/**/node/**", "src/engine/**/*.test.ts"]
}
