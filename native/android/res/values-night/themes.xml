    <color name="ink">#F2EFE9</color>
    <color name="soft">#B5AFA7</color>
    <color name="brick">#E89266</color>
    <color name="on_brick">#1D0F07</color>
    <color name="field">#1FF2EFE9</color>
    <color name="line">#24F2EFE9</color>
    <color name="page_top">#121110</color>
    <color name="page_bottom">#1A1816</color>
    <style name="Aula" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/brick</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
