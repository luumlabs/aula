<?xml version="1.0" encoding="utf-8"?>
<!-- «Papel y luz»: papel cálido de fondo y el ladrillo como única luz, los mismos tokens que la interfaz
     (src/renderer/src/styles.css: paper, surface…). Sin barra de título: la pantalla es la de Aula. -->
<resources>
    <color name="paper">#FAF8F3</color>
    <color name="ink">#191714</color>
    <color name="soft">#68635B</color>
    <color name="brick">#B8502D</color>
    <color name="on_brick">#FFFDF9</color>
    <color name="field">#0F191714</color>
    <color name="line">#1A191714</color>
    <color name="icon_paper">#FDFCF9</color>
    <!-- lo que se ve bajo las barras mientras la página no dice sus colores: arriba la hoja con su grano (paper, un poco
         más oscura en promedio), abajo la barra de pestañas (surface) -->
    <color name="page_top">#FAF8F3</color>
    <color name="page_bottom">#FFFDF9</color>
    <style name="Aula" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/brick</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
