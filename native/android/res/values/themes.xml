<?xml version="1.0" encoding="utf-8"?>
<!-- «Papel y luz»: papel cálido de fondo (el mismo de los dibujos, para que no se vea su borde) y el ladrillo como única luz. Sin
     barra de título: la pantalla es la de Aula. -->
<resources>
    <color name="paper">#FCF9F3</color>
    <color name="ink">#2A2520</color>
    <color name="soft">#77716A</color>
    <color name="brick">#B4502F</color>
    <color name="on_brick">#FFFFFF</color>
    <color name="field">#0F2A2520</color>
    <color name="icon_paper">#F2EADC</color>
    <style name="Aula" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/brick</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
