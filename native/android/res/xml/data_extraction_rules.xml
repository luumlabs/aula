<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de la app se copia, ni a la nube ni a otro teléfono (Android 12 o posterior; AndroidManifest.xml): la identidad de
     Tailscale (que además vive en no_backup, que Android nunca copia) y la cookie de la vista web que enlaza este
     dispositivo con la Aula. Cada dominio va aparte: excluir «root» no alcanza a files, databases ni shared_prefs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
