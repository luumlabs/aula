<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- La interfaz se carga por el túnel local (http://127.0.0.1:<puerto>): sin TLS solo en este mismo dispositivo. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Los textos de los permisos, en inglés aquí y en español en Aula/es.lproj/InfoPlist.strings.
	     Al dar materiales a un curso desde el dispositivo se puede hacer una foto o grabar la clase. -->
	<key>NSCameraUsageDescription</key>
	<string>To photograph your notes or the whiteboard and give them to Aula as course material.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>To record a class and give it to Aula as course material.</string>
	<!-- La red privada intenta hablar con el Mac directamente cuando los dos están en la misma red. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>To reach the Aula on your Mac directly when both are on the same network.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Paper</string>
	</dict>
</dict>
</plist>
