  {
   "id": "als-b05",
   "type": "example",
   "title": "A lawn sprinkler",
   "problem": "A sprinkler sprays water $20$ m out and turns through $135^\\circ$. What area does it water?",
   "steps": [
    {
     "md": "Convert to radians: $135^\\circ=\\dfrac{3\\pi}{4}$.",
     "note": "The formula needs radians: plugging in $135$ makes the area about $57$ times too big."
    },
    {
     "md": "$A=\\tfrac12 r^2\\theta=\\tfrac12(20)^2\\cdot\\dfrac{3\\pi}{4}$."
    },
    {
     "md": "$A=150\\pi\\approx471.2\\ \\text{m}^2$."
    }
   ],
   "answer": "$150\\pi\\approx 471\\ \\text{m}^2$"
  },
  {
   "id": "als-b06",
   "type": "example",
   "title": "How far does a bike go?",
   "problem": "A bicycle wheel has radius $33$ cm and turns $4$ times. How far does the bike move?",
   "steps": [
    {
     "md": "Each revolution is $2\\pi$ radians, so $\\theta=4\\cdot2\\pi=8\\pi$."
    },
    {
     "md": "$s=r\\theta=33\\cdot8\\pi=264\\pi$ cm."
    },
    {
     "md": "$264\\pi\\approx829$ cm, a little more than $8$ m."
    }
   ],
   "answer": "$264\\pi\\approx829$ cm"
  },
  {
   "id": "als-b07",
   "type": "callout",
   "kind": "examTip",
   "md": "If the problem gives degrees, convert first. If it asks for an exact answer, leave $\\pi$ in it; otherwise round only at the very end."
  },
  {
   "id": "als-b08",
   "type": "spot",
   "intro": "Find the arc length on a circle of radius $6$ cm with a central angle of $40^\\circ$.",
   "lines": [
    "$s=r\\theta$",
    "$s=6\\cdot40$",
